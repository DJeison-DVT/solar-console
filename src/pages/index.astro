    <script>
      // Scroll reveal
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((e, i) => {
          if (e.isIntersecting) {
            setTimeout(() => e.target.classList.add('visible'), i * 80);
          }
        });
      }, { threshold: 0.12 });

      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

      // Smooth active nav link highlight
      const sections = document.querySelectorAll('section[id]');
      const navLinks = document.querySelectorAll('.nav-links a');
      window.addEventListener('scroll', () => {
        let current = '';
        sections.forEach(s => {
          if (window.scrollY >= s.offsetTop - 120) current = s.id;
        });
        navLinks.forEach(a => {
          a.style.color = a.getAttribute('href') === `#${current}` ? 'var(--moss)' : '';
        });
      });

      // Support button — increment counter via counterapi.dev v1 then navigate
      document.getElementById('support-btn')?.addEventListener('click', async (e) => {
        e.preventDefault();
        try {
          await fetch('https://api.counterapi.dev/v1/diego-villanueva-terrazass-team-3062/solar-console-support/up');
        } catch (err) {
          console.error('Counter error:', err);
        } finally {
          window.location.href = '/gracias';
        }
      });
    </script>

